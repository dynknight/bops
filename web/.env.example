# Public Supabase settings. The anon key is meant for the browser. Row level security
# keeps data on the dynknight profile. The app does not show a sign-in page.
# Never put a provider key or the service role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Dispatcher shared secret. Vercel Cron sends it as Authorization: Bearer <value>.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Free default model provider. If this is unset, chat fails closed.
# The app does not switch to a paid provider.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Each adapter is off until its own key is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional connected apps. Read-only tools run immediately. Writes wait for approval.
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_USER_ID=dynknight

# Optional social posting. Every post and reply waits for exact-text approval.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
